# Frontend environment variables (read at build time by Vite)
# Local development:
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
# Production: set in the Render static site's environment, e.g.
# VITE_API_BASE_URL=https://<your-api>.onrender.com/api/v1
# Marketing site (all optional). Without a Play URL, /install shows the WhatsApp waitlist.
# VITE_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=<package>
# VITE_WHATSAPP_NUMBER=91XXXXXXXXXX

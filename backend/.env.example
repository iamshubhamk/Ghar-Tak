# Local development settings. Copy to backend/.env.
# Production values are set in the Render dashboard; see .env.production.example.
APP_NAME="GharTak API"
ENVIRONMENT=local
DEBUG=true

CORS_ORIGINS="http://localhost:5173"
FRONTEND_ORIGIN="http://localhost:5173"

# Local MongoDB from `docker compose up -d`
MONGODB_URL="mongodb://localhost:27017/ghartak"

# Only used when ENVIRONMENT=local. Outside local the server refuses to start with the default,
# empty or a short secret (AR-006).
JWT_SECRET_KEY="change-this-local-secret"

# Self-service password reset has no OTP yet (AR-002). Keep false except for local dev.
PASSWORD_RESET_SELF_SERVICE_ENABLED=false

# App settings served to the mobile app at GET /api/v1/app/config (all optional)
# APP_MIN_SUPPORTED_VERSION=1.0.0   # builds below this are blocked with an "update the app" screen
# APP_LATEST_VERSION=1.0.0
# PLAY_STORE_URL=                   # the update button's target; leave empty until the app is listed
# SUPPORT_PHONE=                    # shown on the help button
# LAUNCH_VISIT_CHARGE_INR=99
# LAUNCH_OFFER_ENDS_AT=             # for example 2026-12-31T18:30:00+00:00
# ASSIGNMENT_PROMISE_MINUTES=30
# SERVICE_WINDOW_START=08:00
# SERVICE_WINDOW_END=22:00
# APP_FLAGS={"some_flag": true}

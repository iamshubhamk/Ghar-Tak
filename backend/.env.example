# Backend Environment Variables
APP_NAME="GharTak API"
ENVIRONMENT=production
DEBUG=false

# CORS Origins (Include your deployed frontend domain)
CORS_ORIGINS="https://officialghartak.com,https://www.officialghartak.com,http://localhost:5173"
FRONTEND_ORIGIN="https://officialghartak.com"

# Database Connection (MongoDB Atlas connection string)
MONGODB_URL="mongodb+srv://<username>:<password>@cluster.mongodb.net/ghartak?retryWrites=true&w=majority"

# JWT Secret
JWT_SECRET_KEY="your-production-secret-key-here"

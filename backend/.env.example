# Backend Environment Variables
APP_NAME="GharTak API"
ENVIRONMENT=production
DEBUG=false

# CORS Origins (Include your deployed frontend domain)
CORS_ORIGINS="https://officialghartak.com,https://www.officialghartak.com,http://localhost:5173"
FRONTEND_ORIGIN="https://officialghartak.com"

# Database Connection (MongoDB Atlas connection string)
MONGODB_URL="mongodb+srv://<username>:<password>@cluster.mongodb.net/ghartak?retryWrites=true&w=majority"

# JWT Secret (AR-006). Outside ENVIRONMENT=local the server refuses to start if this is the default,
# empty or shorter than 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The placeholder below is deliberately too short, so it must be replaced.
JWT_SECRET_KEY="replace-me-see-comment-above"

# Self-service password reset has no OTP yet (AR-002). Keep false in production; true only for local dev.
PASSWORD_RESET_SELF_SERVICE_ENABLED=false

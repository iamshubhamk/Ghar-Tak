# Production variable NAMES only. Never put real values in git: set them in the Render dashboard.
APP_NAME="GharTak API"
ENVIRONMENT=production
DEBUG=false

# Comma-separated list of the deployed web origins
CORS_ORIGINS="https://<your-web-domain>"
FRONTEND_ORIGIN="https://<your-web-domain>"

# MongoDB Atlas connection string (secret)
MONGODB_URL="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ghartak?retryWrites=true&w=majority"

# Must be 32+ random characters (AR-006). Generate locally:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY="<generate-and-set-in-render>"

# Must stay false in production until password reset has an OTP (AR-002).
PASSWORD_RESET_SELF_SERVICE_ENABLED=false
